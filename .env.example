# Example environment for the frontend's standalone docker-compose.
# Copy to `.env` (git-ignored) and adjust. Contains NO secrets — the frontend
# never holds credentials, keys or connection strings (spec section 20).

# Upstream the frontend Nginx reverse-proxies /api and /health to.
# Must be the backend's published Nginx, so the browser stays same-origin.
SGE_FRONTEND_API_UPSTREAM=https://host.docker.internal:8443
